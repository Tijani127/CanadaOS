#!/bin/bash
# sorry-shell — the Sorry Terminal's shell: plain bash with Canadian commands.
# bash --rcfile keeps the aliases and prompt from /etc/canadaos/sorryrc.
cat <<'BANNER'
Welcome to the Sorry Terminal (real bash).

Canadian commands: sorry, hockey, poursyrup, toque, beaver, beavertail,
timmy, maple-lint, canadaos-version. Aliases: igloo (ls -la), hoser (whoami),
brew (timmy), hockey-night, syrup-check.

This shell apologizes before, during and after everything.
BANNER

exec bash --rcfile /etc/canadaos/sorryrc